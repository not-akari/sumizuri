<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The backgrounds of the default theme, shown while the app opens. -->
    <color name="start_light">#F5F4EF</color>
    <color name="start_dark">#0F1114</color>
    <color name="start_background">@color/start_light</color>

    <!-- The window of the app, in the background it opens with until the theme of the person is known. -->
    <style name="Theme.Sumizuri" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/start_background</item>
    </style>

    <!-- The splash screen, drawn by the app itself before Android 12, with the icon of the app. -->
    <style name="Theme.Sumizuri.Start" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/start_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Sumizuri</item>
    </style>
    <style name="Theme.Sumizuri.Start.Light">
        <item name="windowSplashScreenBackground">@color/start_light</item>
    </style>
    <style name="Theme.Sumizuri.Start.Dark">
        <item name="windowSplashScreenBackground">@color/start_dark</item>
    </style>
</resources>
