# The keys of the build. Copy this file to .env and fill it in. The .env file is never kept in git.

# The client id of an AniList app, made at https://anilist.co/settings/developer with the redirect URL sumizuri://track/anilist.
# Without it the app still builds, but signing in to AniList is off.
ANILIST_CLIENT_ID=

# The client id of a MyAnimeList app, made at https://myanimelist.net/apiconfig with App Type Other and the redirect URL sumizuri://track/mal. It needs no secret.
# Without it the app still builds, but signing in to MyAnimeList is off.
MAL_CLIENT_ID=

# The client id of a MangaBaka app, made on MangaBaka under Developers with Type Native App, Public application on, and the redirect URL sumizuri://track/mangabaka. It needs no secret, never add one.
# Without it the app signs in to MangaBaka with a personal access token instead.
MANGABAKA_CLIENT_ID=
